generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                 String           @id @default(uuid())
  name               String
  slug               String           @unique
  email              String           @unique
  phone              String?
  website            String?
  logo               String?
  address            String?
  city               String?
  state              String?
  country            String           @default("Kenya")
  registrationNumber String?
  churchType         String?
  churchSize         String?
  numberOfBranches   Int              @default(1)
  numberOfMembers    Int              @default(0)
  subscriptionPlan   SubscriptionPlan @default(STARTER)
  status             TenantStatus     @default(PENDING_VERIFICATION)
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  storageUsedMb      Int              @default(0)
  isVerified         Boolean          @default(false)
  verifiedAt         DateTime?
  suspendedAt        DateTime?
  suspendedReason    String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  assets             Asset[]
  attendance         Attendance[]
  auditLogs          AuditLog[]
  baptisms           Baptism[]
  budgets            Budget[]
  documents          Document[]
  donations          Donation[]
  employees          Employee[]
  events             Event[]
  expenses           Expense[]
  fundCategories     FundCategory[]
  members            Member[]
  ministries         Ministry[]
  parishes           Parish[]
  payrolls           Payroll[]
  projects           Project[]
  refreshTokens      RefreshToken[]
  supportTickets     SupportTicket[]
  roles              TenantRole[]
  settings           TenantSettings?
  users              User[]
  visitors           Visitor[]
}

model User {
  id            String         @id @default(uuid())
  tenantId      String?
  fullname      String
  email         String         @unique
  phone         String?
  passwordHash  String
  role          UserRole       @default(STAFF)
  status        UserStatus     @default(ACTIVE)
  avatar        String?
  position      String?
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model Member {
  id            String         @id @default(uuid())
  tenantId      String
  memberNo      String
  fullname      String
  email         String?
  phone         String?
  gender        Gender?
  dateOfBirth   DateTime?
  maritalStatus MaritalStatus?
  address       String?
  city          String?
  occupation    String?
  employer      String?
  status        MemberStatus   @default(ACTIVE)
  parishId      String?
  ministryId    String?
  joinedAt      DateTime       @default(now())
  baptisedAt    DateTime?
  photo         String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  baptisms      Baptism[]
  donations     Donation[]
  ministry      Ministry?      @relation(fields: [ministryId], references: [id])
  parish        Parish?        @relation(fields: [parishId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memberNo])
  @@index([tenantId])
}

model Employee {
  id         String    @id @default(uuid())
  tenantId   String
  employeeNo String
  fullname   String
  email      String?
  phone      String?
  department String?
  position   String?
  salary     Decimal?
  status     String    @default("ACTIVE")
  startDate  DateTime?
  endDate    DateTime?
  photo      String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payrolls   Payroll[]

  @@unique([tenantId, employeeNo])
  @@index([tenantId])
}

model Parish {
  id         String       @id @default(uuid())
  tenantId   String
  name       String
  address    String?
  city       String?
  phone      String?
  email      String?
  leaderId   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  attendance Attendance[]
  members    Member[]
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Ministry {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  leaderId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     Member[]
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Donation {
  id             String        @id @default(uuid())
  tenantId       String
  memberId       String?
  memberName     String?
  amount         Decimal
  currency       String        @default("KES")
  paymentMethod  PaymentMethod @default(CASH)
  category       String?
  fundCategoryId String?
  description    String?
  receiptNo      String?
  donatedAt      DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  fundCategory   FundCategory? @relation(fields: [fundCategoryId], references: [id])
  member         Member?       @relation(fields: [memberId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Asset {
  id          String    @id @default(uuid())
  tenantId    String
  assetName   String
  assetCode   String?
  category    String?
  description String?
  assetValue  Decimal?
  location    String?
  status      String    @default("ACTIVE")
  condition   String?
  purchasedAt DateTime?
  photo       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Event {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean   @default(false)
  category    String?
  status      String    @default("UPCOMING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Project {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  budget      Decimal?
  status      String    @default("PLANNING")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Expense {
  id            String        @id @default(uuid())
  tenantId      String
  expenseNo     String
  description   String
  amount        Decimal
  currency      String        @default("KES")
  category      String?
  paymentMethod PaymentMethod @default(CASH)
  paidTo        String?
  approvedBy    String?
  receiptNo     String?
  notes         String?
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Attendance {
  id          String   @id @default(uuid())
  tenantId    String
  date        DateTime
  serviceType String?
  adults      Int      @default(0)
  children    Int      @default(0)
  visitors    Int      @default(0)
  total       Int      @default(0)
  notes       String?
  parishId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  parish      Parish?  @relation(fields: [parishId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Budget {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  fiscalYear Int
  category   String
  budgeted   Decimal
  spent      Decimal  @default(0)
  status     String   @default("ACTIVE")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Payroll {
  id            String        @id @default(uuid())
  tenantId      String
  employeeId    String
  period        String
  basicSalary   Decimal
  allowances    Decimal       @default(0)
  deductions    Decimal       @default(0)
  netPay        Decimal
  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  paidAt        DateTime?
  status        String        @default("PENDING")
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  employee      Employee      @relation(fields: [employeeId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Document {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  category   String?
  fileUrl    String?
  fileSize   Int?
  mimeType   String?
  uploadedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantRole {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  permissions Json?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TenantSettings {
  id               String   @id @default(uuid())
  tenantId         String   @unique
  currency         String   @default("KES")
  fiscalYearStart  Int      @default(1)
  timezone         String   @default("Africa/Nairobi")
  dateFormat       String   @default("DD/MM/YYYY")
  memberNoPrefix   String   @default("MBR")
  employeeNoPrefix String   @default("EMP")
  receiptNoPrefix  String   @default("RCP")
  enableSMS        Boolean  @default(false)
  enableEmail      Boolean  @default(false)
  smsGateway       String?
  emailProvider    String?
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  primaryColor     String   @default("#1a237e")
  secondaryColor   String   @default("#c8a415")
  pastorName       String?
  pastorSignature  String?
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id         String    @id @default(uuid())
  tenantId   String?
  subject    String
  message    String
  status     String    @default("OPEN")
  priority   String    @default("MEDIUM")
  category   String?
  response   String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  userEmail String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String?
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  TRIAL
  EXPIRED
}

enum SubscriptionPlan {
  STARTER
  STANDARD
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  SUPERADMIN
  TENANT_ADMIN
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  DECEASED
}

enum PaymentMethod {
  CASH
  MPESA
  AIRTEL_MONEY
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum BaptismStatus {
  PENDING
  APPROVED
  REJECTED
}

model Visitor {
  id                String    @id @default(uuid())
  tenantId          String
  fullname          String
  phone             String?
  email             String?
  address           String?
  gender            Gender?
  ageGroup          String?
  visitDate         DateTime  @default(now())
  invitedBy         String?
  howHeard          String?
  purposeOfVisit    String?
  notes             String?
  followedUp        Boolean   @default(false)
  followUpNote      String?
  followUpDate      DateTime?
  convertedToMember Boolean   @default(false)
  memberId          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([visitDate])
}

model Baptism {
  id             String        @id @default(uuid())
  tenantId       String
  memberId       String
  certificateNo  String?
  baptismDate    DateTime
  baptismType    String        @default("WATER")
  officiantName  String?
  venue          String?
  witnesses      String?
  photo          String?
  status         BaptismStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  member         Member        @relation(fields: [memberId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model FundCategory {
  id           String     @id @default(uuid())
  tenantId     String
  name         String
  description  String?
  color        String?
  targetAmount Decimal?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  donations    Donation[]
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}
